rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // ATURAN KEAMANAN - FASE PENGUJIAN
    // Semua pengguna dapat membaca dan menulis
    // PENTING: Ganti ini dengan aturan yang lebih ketat di produksi!
    // Contoh aturan produksi:
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
    // ============================================================
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
